{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/drip-campaigns",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/deadline-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
